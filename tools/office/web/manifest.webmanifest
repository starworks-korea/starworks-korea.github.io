{
  "name": "한눈뷰어 — 초경량 통합 문서 뷰어",
  "short_name": "한눈뷰어",
  "description": "한글(HWP/HWPX) · 워드 · PDF · 파워포인트 · 엑셀 · CSV 초경량 로컬 문서 뷰어",
  "lang": "ko",
  "start_url": "/tools/office/doc_viewer.html?app=1",
  "scope": "/tools/office/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0b1120",
  "theme_color": "#0b1120",
  "icons": [
    { "src": "icons/doc-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/doc-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/doc-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/tools/office/doc_viewer_share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "files",
          "accept": [
            "*/*",
            "application/octet-stream",
            "application/haansofthwp",
            "application/x-hwp",
            "application/vnd.hancom.hwp",
            "application/vnd.hancom.hwpx",
            "application/pdf",
            "application/msword",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "application/vnd.ms-powerpoint",
            "application/vnd.openxmlformats-officedocument.presentationml.presentation",
            "application/vnd.ms-excel",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            "text/csv",
            "text/plain",
            "text/markdown",
            "image/*",
            ".hwp", ".hwpx", ".pdf", ".docx", ".doc", ".pptx", ".ppt", ".xlsx", ".xls", ".csv", ".tsv", ".txt", ".md"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/tools/office/doc_viewer.html",
      "accept": {
        "application/octet-stream": [".hwp", ".hwpx"],
        "application/haansofthwp": [".hwp"],
        "application/vnd.hancom.hwp": [".hwp"],
        "application/vnd.hancom.hwpx": [".hwpx"],
        "application/pdf": [".pdf"],
        "application/msword": [".doc"],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"],
        "application/vnd.ms-powerpoint": [".ppt"],
        "application/vnd.openxmlformats-officedocument.presentationml.presentation": [".pptx"],
        "application/vnd.ms-excel": [".xls"],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"],
        "text/csv": [".csv", ".tsv"],
        "text/plain": [".txt", ".md"]
      }
    }
  ]
}
