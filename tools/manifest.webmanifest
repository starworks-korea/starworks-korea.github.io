{
  "name": "스타웍스 CAD 뷰어",
  "short_name": "스타웍스 CAD",
  "description": "DWG · DXF · SVG · AI · STEP · IGES · STL 도면·모델 보기",
  "lang": "ko",
  "start_url": "/tools/sw_viewer.html?app=1",
  "scope": "/tools/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#1E3252",
  "theme_color": "#0b1120",
  "icons": [
    { "src": "icons/viewer-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/viewer-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/viewer-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/tools/sw_viewer_share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "files",
          "accept": [
            "*/*",
            "application/octet-stream", "application/acad", "application/x-acad", "application/dwg", "application/x-dwg",
            "application/autocad_dwg", "image/vnd.dwg", "image/x-dwg", "application/dxf", "application/x-dxf",
            "image/vnd.dxf", "image/x-dxf", "model/stl", "application/sla", "application/vnd.ms-pki.stl",
            "model/step", "application/step", "model/iges", "application/iges",
            "image/svg+xml", "application/postscript", "application/illustrator", "application/vnd.adobe.illustrator", "application/pdf",
            ".dwg", ".dxf", ".svg", ".ai", ".stp", ".step", ".igs", ".iges", ".stl"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/tools/sw_viewer.html",
      "accept": {
        "application/octet-stream": [".dwg", ".dxf", ".svg", ".ai", ".stp", ".step", ".igs", ".iges", ".stl"],
        "image/svg+xml": [".svg"],
        "application/postscript": [".ai"],
        "image/vnd.dwg": [".dwg"],
        "image/vnd.dxf": [".dxf"],
        "model/stl": [".stl"],
        "model/step": [".stp", ".step"],
        "model/iges": [".igs", ".iges"]
      }
    }
  ]
}
